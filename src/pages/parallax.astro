---
import VersionsNav from '../components/VersionsNav.astro';
import en from '../i18n/en';
import es from '../i18n/es';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Enrique Ríos - Senior Tech Engineer & AI Engineer. Parallax portfolio." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800;900&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <title>Enrique Ríos | Parallax</title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    html{background:#050505}
    body{font-family:'Outfit',sans-serif;color:#f0f0f0;background:#050505;overflow-x:hidden}

    /* Fixed particle background */
    canvas#particles{position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:0}

    /* Scroll content */
    .scroll-content{position:relative;z-index:1}

    /* Hero - tall so we have scroll room for the zoom effect */
    .hero-zone{height:300vh;position:relative}
    .hero-sticky{position:sticky;top:0;height:100vh;display:flex;align-items:center;justify-content:center;overflow:hidden}

    /* Name layers - will be animated by JS */
    .name-layer{position:absolute;white-space:nowrap;font-weight:900;letter-spacing:-0.07em;text-transform:uppercase;transition:none;will-change:transform,opacity}
    .name-first{font-size:clamp(5rem,18vw,14rem);-webkit-text-stroke:2px #f0f0f0;color:transparent}
    .name-last{font-size:clamp(5rem,18vw,14rem);color:#f0f0f0}
    .hero-role{position:absolute;font-family:'Geist Mono',monospace;font-size:clamp(0.6rem,1vw,0.8rem);color:#666;letter-spacing:0.2em;text-transform:uppercase;opacity:0;transition:none;will-change:transform,opacity}
    .hero-subtitle{position:absolute;font-family:'Geist Mono',monospace;font-size:0.75rem;color:#f6821f;letter-spacing:0.1em;text-transform:uppercase;will-change:transform,opacity;left:50%;top:50%;transform:translateX(-50%) translateY(5rem);white-space:nowrap}

    /* Cards zone */
    .cards-zone{position:relative;padding:0 2rem 10rem}
    .card-row{display:flex;justify-content:center;margin-bottom:4rem}

    .parallax-card{
      max-width:550px;
      width:100%;
      background:rgba(8,8,8,0.9);
      border:1px solid rgba(255,255,255,0.05);
      backdrop-filter:blur(8px);
      padding:2.5rem;
      opacity:0;
      transform:translateY(80px);
      transition:opacity 0.8s cubic-bezier(0.16,1,0.3,1), transform 0.8s cubic-bezier(0.16,1,0.3,1);
    }
    .parallax-card.visible{
      opacity:1;
      transform:translateY(0);
    }
    .parallax-card:nth-child(odd){transform:translateY(80px) translateX(-30px)}
    .parallax-card:nth-child(even){transform:translateY(80px) translateX(30px)}
    .parallax-card.visible:nth-child(odd),
    .parallax-card.visible:nth-child(even){transform:translateY(0) translateX(0)}

    .section-label{font-family:'Geist Mono',monospace;font-size:0.6rem;text-transform:uppercase;letter-spacing:0.15em;color:#f6821f;margin-bottom:0.8rem}
    .section-heading{font-size:clamp(1.4rem,2.5vw,1.8rem);font-weight:700;letter-spacing:-0.03em;margin-bottom:1.2rem}

    /* Experience */
    .exp-item{padding:0.9rem 0;border-bottom:1px solid rgba(255,255,255,0.04)}
    .exp-item:last-child{border:none}
    .exp-item h3{font-size:0.9rem;font-weight:600}
    .exp-item p{font-family:'Geist Mono',monospace;font-size:0.65rem;color:#666;margin-top:0.15rem}
    .exp-item .period{color:#f6821f}

    /* Projects */
    .project-link{display:block;padding:1rem;margin-top:0.6rem;border:1px solid rgba(255,255,255,0.06);text-decoration:none;color:#f0f0f0;transition:all 0.4s cubic-bezier(0.16,1,0.3,1)}
    .project-link:hover{border-color:#f6821f;transform:translateX(8px);box-shadow:-4px 0 0 #f6821f}
    .project-link strong{display:block;font-size:0.9rem}
    .project-link small{font-family:'Geist Mono',monospace;font-size:0.6rem;color:#666}

    /* Tags */
    .tags{display:flex;flex-wrap:wrap;gap:0.5rem;margin-top:1rem}
    .tag{font-family:'Geist Mono',monospace;font-size:0.6rem;padding:0.3rem 0.7rem;border:1px solid rgba(255,255,255,0.08);color:#888;transition:all 0.3s}
    .tag:hover{border-color:#f6821f;color:#f6821f;transform:translateY(-2px)}
    .tag.ai{border-color:rgba(200,80,192,0.3);color:#c850c0}

    /* Contact */
    .contact-link{display:flex;align-items:center;gap:0.8rem;padding:0.8rem;margin-top:0.6rem;border:1px solid rgba(255,255,255,0.06);text-decoration:none;color:#f0f0f0;transition:all 0.3s}
    .contact-link:hover{border-color:#f6821f;color:#f6821f;transform:translateX(4px)}
    .contact-link svg{width:18px;height:18px;opacity:0.6;flex-shrink:0}

    @media(max-width:768px){
      .parallax-card{margin:0 1rem;padding:1.5rem}
      .name-first,.name-last{font-size:clamp(3rem,15vw,8rem)!important}
    }
  </style>
</head>
<body>
  <VersionsNav current="/parallax" accent="#f6821f" />

  <!-- Fixed particle background -->
  <canvas id="particles"></canvas>

  <div class="scroll-content">
    <!-- Hero zone: tall area where name zoom + split happens -->
    <div class="hero-zone">
      <div class="hero-sticky">
        <div class="name-layer name-first" id="name-first">Enrique</div>
        <div class="name-layer name-last" id="name-last">Ríos</div>
        <div class="hero-subtitle" id="hero-subtitle">Senior Tech Engineer → AI Engineer</div>
        <div class="hero-role" id="hero-role">Senior Tech Engineer → AI Engineer</div>
      </div>
    </div>

    <!-- Cards appear after the camera passes through the name -->
    <div class="cards-zone">
      <div class="card-row">
        <div class="parallax-card" data-reveal>
          <div class="section-label">Experiencia</div>
          <h2 class="section-heading">Donde he trabajado</h2>
          <div class="exp-item"><h3>Senior Tech Engineer</h3><p>Allfunds Bank <span class="period">2024 - Presente</span></p></div>
          <div class="exp-item"><h3>Senior Developer</h3><p>Tenant Evaluation <span class="period">2021 - 2024</span></p></div>
          <div class="exp-item"><h3>Mobile / Backend Developer</h3><p>Grupo AL <span class="period">2015 - 2021</span></p></div>
          <div class="exp-item"><h3>ABAP Developer</h3><p>CEMOSA <span class="period">2014 - 2015</span></p></div>
        </div>
      </div>

      <div class="card-row">
        <div class="parallax-card" data-reveal>
          <div class="section-label">Proyectos</div>
          <h2 class="section-heading">Side projects</h2>
          <a href="https://github.com/EnriqueRS/travelmap" target="_blank" class="project-link"><strong>TravelMap</strong><small>SvelteKit + NestJS + PostGIS</small></a>
          <a href="https://github.com/EnriqueRS/runapp" target="_blank" class="project-link"><strong>RunApp</strong><small>Next.js + PostgreSQL</small></a>
          <a href="https://github.com/EnriqueRS/antimolebot" target="_blank" class="project-link"><strong>AntimoleBot</strong><small>Hono + Cloudflare Workers</small></a>
          <a href="https://github.com/EnriqueRS" target="_blank" class="project-link"><strong>30+ repos en GitHub</strong><small>Spring Boot, Angular, Android, y mas</small></a>
        </div>
      </div>

      <div class="card-row">
        <div class="parallax-card" data-reveal>
          <div class="section-label">Core Stack</div>
          <h2 class="section-heading">Tecnologias</h2>
          <div class="tags">
            <span class="tag">Java</span><span class="tag">Spring Boot</span><span class="tag">Python</span>
            <span class="tag">TypeScript</span><span class="tag">Node.js</span><span class="tag">React</span>
            <span class="tag">Docker</span><span class="tag">Kubernetes</span><span class="tag">AWS</span>
            <span class="tag">PostgreSQL</span>
          </div>
          <div style="margin-top:1.5rem"><div class="section-label">AI / ML</div></div>
          <div class="tags">
            <span class="tag ai">LLM Integration</span><span class="tag ai">AI Agents</span>
            <span class="tag ai">RAG</span><span class="tag ai">LangChain</span>
            <span class="tag ai">MLOps</span><span class="tag ai">Vector DB</span>
          </div>
        </div>
      </div>

      <div class="card-row">
        <div class="parallax-card" data-reveal>
          <div class="section-label">Contacto</div>
          <h2 class="section-heading">Hablemos</h2>
          <p style="font-size:0.9rem;color:#888;line-height:1.6;margin-bottom:1rem;font-weight:300">Interesado en AI engineering o colaboracion? Contactame.</p>
          <a href="https://github.com/EnriqueRS" target="_blank" class="contact-link">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
          <a href="https://www.linkedin.com/in/enrique-rios-santos-906666b" target="_blank" class="contact-link">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
          <a href="mailto:enriquers85@gmail.com" class="contact-link">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            enriquers85@gmail.com
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    // === PARTICLES (fixed background) ===
    const canvas = document.getElementById('particles') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    let w = canvas.width = window.innerWidth;
    let h = canvas.height = window.innerHeight;
    window.addEventListener('resize', () => { w = canvas.width = window.innerWidth; h = canvas.height = window.innerHeight; });

    const PARTICLE_COUNT = 120;
    const particles = Array.from({ length: PARTICLE_COUNT }, () => ({
      x: Math.random() * w,
      y: Math.random() * h,
      vx: (Math.random() - 0.5) * 0.3,
      vy: (Math.random() - 0.5) * 0.3,
      size: Math.random() * 2 + 0.5,
      alpha: Math.random() * 0.4 + 0.1,
    }));

    function drawParticles() {
      ctx.clearRect(0, 0, w, h);

      particles.forEach(p => {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0) p.x = w;
        if (p.x > w) p.x = 0;
        if (p.y < 0) p.y = h;
        if (p.y > h) p.y = 0;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(246, 130, 31, ${p.alpha})`;
        ctx.fill();
      });

      // Draw connections between nearby particles
      for (let i = 0; i < PARTICLE_COUNT; i++) {
        for (let j = i + 1; j < PARTICLE_COUNT; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 120) {
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.strokeStyle = `rgba(246, 130, 31, ${0.06 * (1 - dist / 120)})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }

      requestAnimationFrame(drawParticles);
    }
    drawParticles();

    // === HERO ZOOM + SPLIT ANIMATION (scroll-driven) ===
    const heroZone = document.querySelector('.hero-zone') as HTMLElement;
    const nameFirst = document.getElementById('name-first') as HTMLElement;
    const nameLast = document.getElementById('name-last') as HTMLElement;
    const heroRole = document.getElementById('hero-role') as HTMLElement;
    const heroSubtitle = document.getElementById('hero-subtitle') as HTMLElement;

    function updateHero() {
      const rect = heroZone.getBoundingClientRect();
      const heroHeight = heroZone.offsetHeight - window.innerHeight;
      // progress: 0 = top of hero zone visible, 1 = end of hero zone
      const scrolled = -rect.top;
      const progress = Math.max(0, Math.min(1, scrolled / heroHeight));

      // Phase 1 (0-0.4): Name centered, slowly zooming in
      // Phase 2 (0.4-0.8): Name splits apart (first goes up-left, last goes down-right)
      // Phase 3 (0.8-1): Names fly off screen, role appears

      if (progress < 0.4) {
        // Zoom in
        const zoom = 1 + progress * 2.5; // 1x to 2x
        const opacity = 1;
        nameFirst.style.transform = `translate(-50%, -80%) scale(${zoom})`;
        nameFirst.style.opacity = String(opacity);
        nameFirst.style.left = '50%';
        nameFirst.style.top = '50%';
        nameLast.style.transform = `translate(-50%, 0%) scale(${zoom})`;
        nameLast.style.opacity = String(opacity);
        nameLast.style.left = '50%';
        nameLast.style.top = '50%';
        heroRole.style.opacity = '0';
        // Subtitle fades out as we zoom in
        const subtitleFade = 1 - (progress / 0.4) * 1.5;
        heroSubtitle.style.opacity = String(Math.max(0, subtitleFade));
        heroSubtitle.style.transform = `translateX(-50%) translateY(calc(5rem + ${progress * 20}px))`;
      } else if (progress < 0.8) {
        // Split apart
        const splitProgress = (progress - 0.4) / 0.4; // 0 to 1
        const zoom = 2 + splitProgress * 3; // 2x to 5x
        const splitX = splitProgress * 60; // vw units
        const splitY = splitProgress * 40;
        const opacity = 1 - splitProgress * 0.7;

        nameFirst.style.transform = `translate(calc(-50% - ${splitX}vw), calc(-80% - ${splitY}vh)) scale(${zoom})`;
        nameFirst.style.opacity = String(opacity);
        nameFirst.style.left = '50%';
        nameFirst.style.top = '50%';
        nameLast.style.transform = `translate(calc(-50% + ${splitX}vw), calc(0% + ${splitY}vh)) scale(${zoom})`;
        nameLast.style.opacity = String(opacity);
        nameLast.style.left = '50%';
        nameLast.style.top = '50%';
        heroSubtitle.style.opacity = '0';
        heroRole.style.opacity = String(splitProgress > 0.5 ? (splitProgress - 0.5) * 2 : 0);
        heroRole.style.transform = `translate(-50%, 0) translateY(${(1 - splitProgress) * 20}px)`;
        heroRole.style.left = '50%';
        heroRole.style.top = '60%';
      } else {
        // Names gone, role visible
        const fadeProgress = (progress - 0.8) / 0.2;
        nameFirst.style.opacity = '0';
        nameLast.style.opacity = '0';
        heroRole.style.opacity = String(1 - fadeProgress);
        heroRole.style.transform = `translate(-50%, 0) translateY(${-fadeProgress * 30}px)`;
        heroRole.style.left = '50%';
        heroRole.style.top = '60%';
      }
    }

    // === CARD REVEAL (intersection observer) ===
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });

    document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el));

    // === SCROLL HANDLER ===
    function onScroll() {
      updateHero();
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>

  <script define:vars={{en,es}}>
    let currentLang=localStorage.getItem('lang')||'es';
    document.getElementById('lang-toggle').textContent=currentLang==='en'?'ES':'EN';
    document.getElementById('lang-toggle').addEventListener('click',()=>{
      currentLang=currentLang==='en'?'es':'en';localStorage.setItem('lang',currentLang);
      document.getElementById('lang-toggle').textContent=currentLang==='en'?'ES':'EN';
    });
  </script>
</body>
</html>
