---
import en from '../i18n/en';
import es from '../i18n/es';
import GravityCanvas from '../components/gravity/GravityCanvas';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Enrique Ríos - Senior Tech Engineer & AI Engineer. Gravity Cards portfolio." />
  <meta name="theme-color" content="#050505" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <title>Enrique Ríos | Gravity</title>
  <style>
    @import "tailwindcss";

    :root {
      --color-bg: #050505;
      --color-surface: #0a0a0a;
      --color-border: #1a1a1a;
      --color-text: #f0f0f0;
      --color-text-secondary: #888888;
      --color-text-muted: #444444;
      --color-accent: #f6821f;
      --color-accent-purple: #c850c0;
      --color-accent-blue: #4158d0;
      --font-display: 'Outfit', sans-serif;
      --font-mono: 'Geist Mono', monospace;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      scrollbar-width: thin;
      scrollbar-color: var(--color-accent) var(--color-bg);
      background: var(--color-bg);
    }

    body {
      font-family: var(--font-display);
      background: transparent;
      color: var(--color-text);
      overflow-x: hidden;
    }

    .scroll-container {
      position: relative;
      z-index: 1;
      height: 400vh;
      background: transparent;
    }

    .section-overlay {
      position: relative;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
    }

    .section-overlay > * {
      pointer-events: auto;
    }

    /* Nav */
    .nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      backdrop-filter: blur(12px);
      background: rgba(5, 5, 5, 0.6);
      border-bottom: 1px solid var(--color-border);
    }

    .nav-logo {
      font-family: var(--font-mono);
      font-size: 0.9rem;
      color: var(--color-text);
      text-decoration: none;
      letter-spacing: -0.02em;
    }

    .nav-logo .accent { color: var(--color-accent); }

    .nav-links {
      display: flex;
      gap: 2rem;
    }

    .nav-links a {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-text-secondary);
      text-decoration: none;
      transition: color 0.3s;
    }

    .nav-links a:hover { color: var(--color-accent); }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .lang-btn {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      background: none;
      border: 1px solid var(--color-border);
      color: var(--color-text-secondary);
      padding: 0.3rem 0.6rem;
      cursor: pointer;
      transition: all 0.3s;
    }

    .lang-btn:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }

    .version-switch {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      color: var(--color-text-muted);
      text-decoration: none;
      border: 1px solid var(--color-border);
      padding: 0.3rem 0.6rem;
      transition: all 0.3s;
    }

    .version-switch:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }

    /* Hero content */
    .hero-content {
      text-align: center;
      max-width: 600px;
      padding: 0 2rem;
    }

    .hero-name {
      font-size: clamp(3rem, 8vw, 5.5rem);
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1;
      margin-bottom: 0.5rem;
      background: linear-gradient(135deg, var(--color-text) 0%, var(--color-text-secondary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-role {
      font-family: var(--font-mono);
      font-size: clamp(0.75rem, 1.2vw, 0.9rem);
      color: var(--color-accent);
      letter-spacing: 0.05em;
      margin-bottom: 1.5rem;
      display: block;
    }

    .hero-sub {
      font-size: 0.95rem;
      color: var(--color-text-secondary);
      line-height: 1.7;
      max-width: 450px;
      margin: 0 auto 2rem;
      font-weight: 300;
    }

    .hero-ctas {
      display: flex;
      gap: 1rem;
      justify-content: center;
    }

    .btn {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 0.7rem 1.6rem;
      text-decoration: none;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-primary {
      background: var(--color-accent);
      color: #000;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(246, 130, 31, 0.3);
    }

    .btn-ghost {
      background: none;
      color: var(--color-text);
      border: 1px solid var(--color-border);
    }

    .btn-ghost:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }

    /* Section cards */
    .section-card {
      background: rgba(10, 10, 10, 0.85);
      backdrop-filter: blur(20px);
      border: 1px solid var(--color-border);
      padding: 2.5rem;
      max-width: 550px;
      width: 100%;
      margin: 0 2rem;
    }

    .section-label {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--color-accent);
      margin-bottom: 0.8rem;
    }

    .section-heading {
      font-size: clamp(1.4rem, 2.5vw, 1.8rem);
      font-weight: 700;
      letter-spacing: -0.03em;
      margin-bottom: 1.2rem;
    }

    /* Projects */
    .project-list {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      margin-top: 1rem;
    }

    .project-item {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.7rem;
      border: 1px solid var(--color-border);
      text-decoration: none;
      color: var(--color-text);
      transition: all 0.3s;
    }

    .project-item:hover {
      border-color: var(--color-accent);
      transform: translateX(4px);
    }

    .project-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .project-item h4 { font-size: 0.85rem; font-weight: 500; }
    .project-item p { font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-text-muted); }

    /* Tech tags */
    .tech-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1rem;
    }

    .tech-tag {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      padding: 0.3rem 0.7rem;
      border: 1px solid var(--color-border);
      color: var(--color-text-secondary);
    }

    .tech-tag.ai {
      border-color: rgba(200, 80, 192, 0.3);
      color: var(--color-accent-purple);
    }

    /* Contact */
    .contact-links {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      margin-top: 1rem;
    }

    .contact-link {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      padding: 0.7rem;
      border: 1px solid var(--color-border);
      text-decoration: none;
      color: var(--color-text);
      transition: all 0.3s;
      font-size: 0.85rem;
    }

    .contact-link:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }

    .contact-link svg { width: 18px; height: 18px; opacity: 0.7; }

    /* Section indicator */
    .section-indicator {
      position: fixed;
      right: 2rem;
      top: 50%;
      transform: translateY(-50%);
      z-index: 50;
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
    }

    .indicator-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--color-text-muted);
      transition: all 0.4s;
      cursor: pointer;
    }

    .indicator-dot.active {
      background: var(--color-accent);
      box-shadow: 0 0 12px var(--color-accent);
      transform: scale(1.5);
    }

    @media (max-width: 768px) {
      .nav-links { display: none; }
      .section-card { margin: 0 1rem; padding: 1.5rem; }
    }
  </style>
</head>
<body>
  <!-- Nav -->
  <nav class="nav">
    <a href="/" class="nav-logo">e<span class="accent">.</span>rios</a>
    <div class="nav-links">
      <a href="#projects" data-i18n="nav.projects"></a>
      <a href="#skills">Skills</a>
      <a href="#contact" data-i18n="nav.contact"></a>
    </div>
    <div class="nav-actions">
      <a href="/" class="version-switch">Infinite Room</a>
      <a href="/particle" class="version-switch">Particles</a>
      <a href="/terminal" class="version-switch">Terminal</a>
      <a href="/liquid" class="version-switch">Liquid</a>
      <a href="/kinetic" class="version-switch">Kinetic</a>
      <a href="/noise" class="version-switch">Noise</a>
      <a href="/magnetic" class="version-switch">Magnetic</a>
      <a href="/collage" class="version-switch">Collage</a>
      <a href="/parallax" class="version-switch">Parallax</a>
      <button id="lang-toggle" class="lang-btn" title="Switch language">EN</button>
    </div>
  </nav>

  <!-- Section dots -->
  <div class="section-indicator" id="section-indicator">
    <div class="indicator-dot active" data-section="0"></div>
    <div class="indicator-dot" data-section="1"></div>
    <div class="indicator-dot" data-section="2"></div>
    <div class="indicator-dot" data-section="3"></div>
  </div>

  <!-- Three.js Canvas -->
  <GravityCanvas client:only="react" />

  <!-- HTML Overlay -->
  <div class="scroll-container">
    <!-- Hero -->
    <div class="section-overlay" id="hero">
      <div class="hero-content">
        <h1 class="hero-name">Enrique Ríos</h1>
        <span class="hero-role">Senior Tech Engineer → AI Engineer</span>
        <p class="hero-sub" data-i18n="hero.subtitle"></p>
        <div class="hero-ctas">
          <a href="https://github.com/EnriqueRS" target="_blank" class="btn btn-primary">GitHub</a>
          <a href="https://www.linkedin.com/in/enrique-rios-santos-906666b" target="_blank" class="btn btn-ghost">LinkedIn</a>
        </div>
      </div>
    </div>

    <!-- Projects -->
    <div class="section-overlay" id="projects">
      <div class="section-card">
        <div class="section-label" data-i18n="projects.label"></div>
        <h2 class="section-heading" data-i18n="projects.heading"></h2>
        <div class="project-list">
          <a href="https://github.com/EnriqueRS/travelmap" target="_blank" class="project-item">
            <div class="project-dot" style="background: #10b981"></div>
            <div><h4>TravelMap</h4><p>SvelteKit + NestJS + PostGIS</p></div>
          </a>
          <a href="https://github.com/EnriqueRS/runapp" target="_blank" class="project-item">
            <div class="project-dot" style="background: #f59e0b"></div>
            <div><h4>RunApp</h4><p>Next.js + PostgreSQL</p></div>
          </a>
          <a href="https://github.com/EnriqueRS/antimolebot" target="_blank" class="project-item">
            <div class="project-dot" style="background: #8b5cf6"></div>
            <div><h4>AntimoleBot</h4><p>Hono + Cloudflare Workers</p></div>
          </a>
          <a href="https://github.com/EnriqueRS" target="_blank" class="project-item">
            <div class="project-dot" style="background: var(--color-text-muted)"></div>
            <div><h4 data-i18n="projects.more"></h4><p>30+ repos</p></div>
          </a>
        </div>
      </div>
    </div>

    <!-- Skills -->
    <div class="section-overlay" id="skills">
      <div class="section-card">
        <div class="section-label" data-i18n="about.stackCore"></div>
        <h2 class="section-heading">Tech Stack</h2>
        <div class="tech-grid">
          <span class="tech-tag">Java</span>
          <span class="tech-tag">Spring Boot</span>
          <span class="tech-tag">Python</span>
          <span class="tech-tag">TypeScript</span>
          <span class="tech-tag">Node.js</span>
          <span class="tech-tag">React</span>
          <span class="tech-tag">Docker</span>
          <span class="tech-tag">Kubernetes</span>
          <span class="tech-tag">AWS</span>
          <span class="tech-tag">PostgreSQL</span>
        </div>
        <div class="section-label" style="margin-top: 1.5rem" data-i18n="about.stackAI"></div>
        <div class="tech-grid">
          <span class="tech-tag ai">LLM Integration</span>
          <span class="tech-tag ai">AI Agents</span>
          <span class="tech-tag ai">RAG</span>
          <span class="tech-tag ai">LangChain</span>
          <span class="tech-tag ai">MLOps</span>
          <span class="tech-tag ai">Vector DB</span>
        </div>
      </div>
    </div>

    <!-- Contact -->
    <div class="section-overlay" id="contact">
      <div class="section-card">
        <div class="section-label" data-i18n="contact.label"></div>
        <h2 class="section-heading" data-i18n="contact.heading"></h2>
        <p style="font-size: 0.9rem; color: var(--color-text-secondary); margin-bottom: 1rem;" data-i18n="contact.sub"></p>
        <div class="contact-links">
          <a href="https://github.com/EnriqueRS" target="_blank" class="contact-link">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
          <a href="https://www.linkedin.com/in/enrique-rios-santos-906666b" target="_blank" class="contact-link">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
          <a href="mailto:enriquers85@gmail.com" class="contact-link">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            enriquers85@gmail.com
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- i18n + indicator script -->
  <script define:vars={{ en, es }}>
    const translations = { en, es };
    let currentLang = localStorage.getItem('lang') || 'es';

    function applyLang(lang) {
      currentLang = lang;
      localStorage.setItem('lang', lang);
      document.documentElement.lang = lang;
      const t = translations[lang];
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        const value = key.split('.').reduce((o, k) => o?.[k], t);
        if (value) el.textContent = value;
      });
      document.getElementById('lang-toggle').textContent = lang === 'en' ? 'ES' : 'EN';
    }

    document.getElementById('lang-toggle').addEventListener('click', () => {
      applyLang(currentLang === 'en' ? 'es' : 'en');
    });

    applyLang(currentLang);

    // Section indicator
    const dots = document.querySelectorAll('.indicator-dot');
    const sections = 4;

    function updateIndicator() {
      const scrollTop = window.scrollY;
      const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollTop / scrollHeight;
      const activeSection = Math.min(Math.floor(progress * sections), sections - 1);
      dots.forEach((dot, i) => dot.classList.toggle('active', i === activeSection));
    }

    window.addEventListener('scroll', updateIndicator, { passive: true });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
        window.scrollTo({ top: (i / (sections - 1)) * scrollHeight, behavior: 'smooth' });
      });
    });
  </script>
</body>
</html>
