---
interface Props {
  current?: string;
  accent?: string;
}

const { current = '', accent = '#f6821f' } = Astro.props;

const versions = [
  { href: '/', label: 'Infinite Room' },
  { href: '/particle', label: 'Particles' },
  { href: '/gravity', label: 'Gravity' },
  { href: '/terminal', label: 'Terminal' },
  { href: '/liquid', label: 'Liquid' },
  { href: '/kinetic', label: 'Kinetic' },
  { href: '/noise', label: 'Noise' },
  { href: '/magnetic', label: 'Magnetic' },
  { href: '/collage', label: 'Collage' },
  { href: '/parallax', label: 'Parallax' },
];
---

<nav class="versions-nav">
  <a href="/" class="versions-logo">e<span style={`color:${accent}`}>.</span>ríos</a>
  <div class="versions-links">
    {versions.map(v => (
      <a
        href={v.href}
        class:list={['versions-link', { active: current === v.href }]}
        style={current === v.href ? `color:${accent};border-color:${accent}` : ''}
      >
        {v.label}
      </a>
    ))}
  </div>
  <button id="lang-toggle" class="versions-lang">EN</button>
</nav>

<style define:vars={{ accent }}>
  .versions-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0.6rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    backdrop-filter: blur(12px);
    background: rgba(5, 5, 5, 0.7);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .versions-nav::-webkit-scrollbar { display: none; }
  .versions-logo {
    font-family: 'Geist Mono', monospace;
    font-size: 0.85rem;
    color: #f0f0f0;
    text-decoration: none;
    flex-shrink: 0;
    letter-spacing: -0.02em;
  }
  .versions-links {
    display: flex;
    gap: 0.4rem;
    flex: 1;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .versions-links::-webkit-scrollbar { display: none; }
  .versions-link {
    font-family: 'Geist Mono', monospace;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #666;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border: 1px solid transparent;
    border-radius: 2px;
    white-space: nowrap;
    transition: all 0.2s;
    flex-shrink: 0;
  }
  .versions-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .versions-link.active {
    border-color: var(--accent);
  }
  .versions-lang {
    font-family: 'Geist Mono', monospace;
    font-size: 0.6rem;
    background: none;
    border: 1px solid rgba(255,255,255,0.1);
    color: #666;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.2s;
  }
  .versions-lang:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  @media (max-width: 768px) {
    .versions-nav { padding: 0.5rem 1rem; }
  }
</style>
